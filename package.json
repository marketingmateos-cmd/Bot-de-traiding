{
  "name": "crypto-ai-trading-lab",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "next dev",
    "build": "node scripts/stamp-service-worker.mjs && next build",
    "start": "next start",
    "start:railway": "node scripts/ensure-db.mjs && next start -p ${PORT:-3000}",
    "vercel-build": "node scripts/stamp-service-worker.mjs && node scripts/generate-postgres-schema.mjs && npx prisma generate --schema=prisma/schema.postgres.prisma && node scripts/ensure-db.mjs prisma/schema.postgres.prisma && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "market-data:import": "tsx scripts/import-historical-market-data.mjs",
    "market-data:import:file": "tsx scripts/import-historical-market-data-from-file.mjs",
    "market-data:coverage": "tsx scripts/check-market-data-coverage.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "electron .",
    "desktop:build:win": "npm run desktop:prepare && electron-builder --win --x64 --publish=never",
    "desktop:build:linux": "npm run desktop:prepare && electron-builder --linux --x64 --publish=never",
    "desktop:build:mac": "npm run desktop:prepare && electron-builder --mac --x64 --publish=never"
  },
  "build": {
    "appId": "com.cryptoaitradinglab.desktop",
    "productName": "Crypto AI Trading Lab",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": ".next/standalone", "to": "app", "filter": ["**/*", "!node_modules"] },
      { "from": ".next/standalone/node_modules", "to": "app/node_modules" },
      { "from": "build-resources/template.db", "to": "template.db" },
      { "from": "build-resources/icon.ico", "to": "icon.ico" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Finance"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.finance"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@prisma/client": "5.22.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lightweight-charts": "4.2.1",
    "lucide-react": "0.454.0",
    "next": "15.5.25",
    "prisma": "5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "tsx": "4.19.2",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "dotenv": "^16.4.5",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
