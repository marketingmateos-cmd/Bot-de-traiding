// Crypto AI Trading Lab — Database Schema
// SQLite + Prisma. Every table that backs a simulated trade carries enough
// context to reconstruct *why* the system did what it did (see: Reproducibility
// Principle in the product spec).
//
// SQLite (a single embedded file, no server process) was chosen over Postgres
// so the whole app — including the packaged Windows desktop build — never
// requires the user to install or configure a separate database server.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// CORE / IDENTITY
// ─────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  accounts    PaperAccount[]
  strategies  Strategy[]
  experiments Experiment[]
  auditLogs   AuditLog[]
}

model Asset {
  id         String   @id @default(cuid())
  symbol     String   @unique // e.g. "BTC"
  name       String
  assetClass String   @default("CRYPTO") // CRYPTO | FOREX | METALS — see AssetClass in src/lib/providers/types.ts
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  marketData           MarketData[]
  marketDataImportLogs MarketDataImportLog[]
  news                 NewsAssetLink[]
  sentiment            SentimentSnapshot[]
  onChainMetrics       OnChainMetric[]
  paperPositions       PaperPosition[]
  paperOrders          PaperOrder[]
  trades               Trade[]
  backtestResults      BacktestResult[]
  benchmarks           Benchmark[]

  @@index([symbol])
}

// ─────────────────────────────────────────────────────────────────────────
// MARKET DATA
// ─────────────────────────────────────────────────────────────────────────

// Timeframe (was a native enum under Postgres): "M1" | "M5" | "M15" | "H1" | "H4" | "D1"
// — kept as a plain String under SQLite, which has no native enum type;
// validity is enforced in the TypeScript layer via the TimeframeCode union.

model MarketData {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String // provider id, e.g. "demo", "coingecko"
  quality   Int      @default(100) // 0-100, from Data Quality Engine
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([assetId, timeframe, timestamp, source])
  @@index([assetId, timeframe, timestamp])
}

// Fase 9 — one row per run of scripts/import-historical-market-data.mjs.
// Lets a re-run answer "what range do I already have for BTC/H1/binance"
// without re-hitting the external API, and gives an honest, persistent
// record of every import attempt (including partial/failed ones) — never
// just a silent console log that disappears.
model MarketDataImportLog {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timeframe     String
  source        String // e.g. "binance"
  rangeStart    DateTime
  rangeEnd      DateTime
  rowsRequested Int      @default(0)
  rowsReceived  Int      @default(0)
  rowsInserted  Int      @default(0)
  rowsUpdated   Int      @default(0)
  rowsSkipped   Int      @default(0)
  rowsInvalid   Int      @default(0)
  status        String // PENDING | DONE | PARTIAL | FAILED
  error         String?
  importedAt    DateTime @default(now())

  @@index([assetId, timeframe, source, importedAt])
}

model DataQualityReport {
  id          String   @id @default(cuid())
  assetId     String?
  timeframe   String?
  score       Int // 0-100
  issues      String // array of {type, severity, message}
  evaluatedAt DateTime @default(now())

  @@index([assetId, timeframe, evaluatedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// RESEARCH DATASET VERSIONING (Fase 14) — a `ResearchDataset` row is a
// named, reproducible SNAPSHOT of a (symbol, timeframe, source) slice of
// already-imported `MarketData` — never a second copy of the candles
// themselves. Registering one re-validates the underlying rows (spec
// section 6: ascending timestamps, no duplicates, valid OHLC/volume,
// aligned H1 intervals, no timestamp past the requested end) and computes
// `datasetHash` over them, so a `Replay`/`StrategyBenchmarkRun` can point
// at this row's id+hash instead of a bare date range and be reconstructed
// exactly later even if more data is imported afterward.
// ─────────────────────────────────────────────────────────────────────────

model ResearchDataset {
  id             String   @id @default(cuid())
  symbol         String // internal Asset.symbol, e.g. "BTC" — same convention as StrategyBenchmarkRun.datasetSymbol
  timeframe      String
  startDate      DateTime
  endDate        DateTime
  rowCount       Int
  source         String // the real MarketData.source these rows came from, e.g. "binance_csv"
  isDemo         Boolean
  coveragePct    Float
  gapCount       Int
  duplicateCount Int
  quality        Int // 0-100, mean of the underlying MarketData.quality rows
  datasetHash    String // sha256 over "timestamp|open|high|low|close|volume" per row, chronological order — see computeDatasetHash()'s own doc comment for the exact algorithm
  createdAt      DateTime @default(now())

  // Registering the identical (symbol, timeframe, start, end, source) range twice is
  // idempotent — returns the existing row rather than creating a duplicate.
  @@unique([symbol, timeframe, startDate, endDate, source])
  @@index([symbol, timeframe])
  @@index([datasetHash])
}

// ─────────────────────────────────────────────────────────────────────────
// NEWS
// ─────────────────────────────────────────────────────────────────────────

// NewsCategory (plain String under SQLite): MACRO | REGULATION | EXCHANGE |
// PROTOCOL | ETF | SECURITY | ADOPTION | PARTNERSHIP | TECHNOLOGY | MARKET | OTHER

model News {
  id          String   @id @default(cuid())
  title       String
  source      String
  url         String?
  publishedAt DateTime
  category    String
  importance  Int // 0-100
  novelty     Int // 0-100, dedup clusters score lower
  sentiment   Float // -1..1
  intensity   Int // 0-100
  entities    String // string[]
  clusterId   String? // groups near-duplicate articles
  impactScore Int // 0-100, computed
  isDemo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  assets NewsAssetLink[]

  @@index([publishedAt])
  @@index([clusterId])
}

model NewsAssetLink {
  id      String @id @default(cuid())
  newsId  String
  news    News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([newsId, assetId])
}

// ─────────────────────────────────────────────────────────────────────────
// SENTIMENT
// ─────────────────────────────────────────────────────────────────────────

model SentimentSnapshot {
  id             String   @id @default(cuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timestamp      DateTime
  score          Float // -1..1
  trend          Float // slope over recent window
  acceleration   Float // 2nd derivative
  priceChangePct Float // paired price change for divergence calc
  divergence     Boolean  @default(false)
  source         String
  isDemo         Boolean  @default(true)

  @@index([assetId, timestamp])
}

// ─────────────────────────────────────────────────────────────────────────
// ON-CHAIN
// ─────────────────────────────────────────────────────────────────────────

model OnChainMetric {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timestamp DateTime
  metric    String // e.g. "exchange_inflow", "active_addresses"
  value     Float?
  available Boolean  @default(false) // false => DATA UNAVAILABLE, value must be null
  source    String
  isDemo    Boolean  @default(true)

  @@index([assetId, metric, timestamp])
}

// ─────────────────────────────────────────────────────────────────────────
// STRATEGIES
// ─────────────────────────────────────────────────────────────────────────

// StrategyKind (plain String under SQLite): TREND_FOLLOWING | MOMENTUM |
// BREAKOUT | MEAN_REVERSION | VOLATILITY | MULTI_TIMEFRAME | EVENT_DRIVEN
//
// MarketRegime (plain String under SQLite): STRONG_BULL | BULL | NEUTRAL |
// BEAR | STRONG_BEAR | HIGH_VOLATILITY | LOW_VOLATILITY | RANGE | TRANSITION

model Strategy {
  id          String   @id @default(cuid())
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id])
  kind        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  versions StrategyVersion[]

  @@index([kind])
}

model StrategyVersion {
  id                 String   @id @default(cuid())
  strategyId         String
  strategy           Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  version            String // "1.0", "1.1", "2.0"
  parameters         String
  timeframe          String
  allowedMarkets     String // string[] asset symbols, [] = all
  recommendedRegimes String // MarketRegime[]
  entryRules         String
  exitRules          String
  stopLossPct        Float?
  takeProfitPct      Float?
  trailingStopPct    Float?
  filters            String
  costModel          String // { feeBps, slippageBps }
  changeLog          String?
  createdAt          DateTime @default(now())
  parentVersionId    String?

  backtests      Backtest[]
  paperOrders    PaperOrder[]
  paperPositions PaperPosition[]
  trades         Trade[]
  hypotheses     Hypothesis[]

  @@unique([strategyId, version])
}

// ─────────────────────────────────────────────────────────────────────────
// BACKTESTING / RESEARCH
// ─────────────────────────────────────────────────────────────────────────

// BacktestKind (plain String under SQLite): SIMPLE | WALK_FORWARD | MONTE_CARLO | ROBUSTNESS

model Backtest {
  id                String          @id @default(cuid())
  strategyVersionId String
  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  kind              String
  assetSymbols      String
  timeframe         String
  startDate         DateTime
  endDate           DateTime
  costModel         String
  status            String          @default("PENDING") // PENDING, RUNNING, DONE, FAILED
  summary           String? // headline metrics
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  results BacktestResult[]

  @@index([strategyVersionId])
}

model BacktestResult {
  id          String   @id @default(cuid())
  backtestId  String
  backtest    Backtest @relation(fields: [backtestId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  windowLabel String? // e.g. "train", "oos", "wf-3", "mc-run-42"
  metrics     String // return, sharpe, sortino, maxDD, winRate, trades, etc.
  equityCurve String // [{t, equity}]
  trades      String // lightweight trade list for this run
  createdAt   DateTime @default(now())

  @@index([backtestId, assetId])
}

// ─────────────────────────────────────────────────────────────────────────
// HISTORICAL REPLAY (Fase 7-8) — deliberately its own tables, never sharing
// a row with PaperAccount/PaperPosition/Trade: a replay is a simulation
// over historical data, structurally isolated from live paper trading
// state (see src/lib/replay/replayPortfolio.ts's own doc comment).
// `strategyId` is the STATIC StrategyDefinition id from the registry
// (e.g. "trend-following"), not a StrategyVersion row — a replay can also
// run "Bot completo" (every registered strategy at once), which has no
// single StrategyVersion to point at, so this is intentionally a plain
// string rather than a foreign key.
// ─────────────────────────────────────────────────────────────────────────

model ReplayRun {
  id                String    @id @default(cuid())
  strategyId        String? // null = "Bot completo" (every strategy in the registry)
  assetSymbols      String // JSON string[]
  timeframe         String
  startDate         DateTime
  endDate           DateTime
  aiMode            String // FULL_HISTORICAL | DETERMINISTIC_AI | AI_ASSISTED
  dataSource        String // SYNTHETIC | HISTORICAL_REAL
  initialCapital    Float
  riskLevel         Int
  hasSegments       Boolean   @default(false) // true when IS/VALIDATION/OOS ranges were configured
  hasWalkForward    Boolean   @default(false)
  status            String    @default("PENDING") // PENDING, RUNNING, DONE, FAILED
  dataQualityReport String? // JSON ReplayDataQualityReport
  walkForward       String? // JSON WalkForwardResult, null if not requested
  robustness        String? // JSON ReplayRobustnessReport
  overfitting       String? // JSON OverfittingReport
  evidence          String? // JSON EvidenceQualityReport
  // Fase 14 — loose reference (like strategyId, never a Prisma relation) to the ResearchDataset this run's config.datasetId named, when one was given. Optional/nullable: undefined for every run predating Fase 14.
  datasetId         String?
  // Fase 14 — the referenced dataset's OWN datasetHash at the time this run started, copied here (not just joined via datasetId) so a row stays reproducible-by-hash even if the ResearchDataset row were ever deleted.
  datasetHash       String?
  error             String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  results ReplayResult[]
}

model ReplayResult {
  id            String    @id @default(cuid())
  replayRunId   String
  replayRun     ReplayRun @relation(fields: [replayRunId], references: [id], onDelete: Cascade)
  windowLabel   String // "FULL", "IS", "VALIDATION", "OOS"
  metrics       String // JSON ReplayMetrics
  equityCurve   String // JSON [{t, equity}]
  drawdownCurve String // JSON [{t, drawdownPct}]
  trades        String // JSON ReplayTradeRecord[]
  decisions     String // JSON ReplayDecisionRecord[] — the "WHY DID THE BOT ENTER" audit trail
  createdAt     DateTime  @default(now())

  @@index([replayRunId])
}

// ─────────────────────────────────────────────────────────────────────────
// STRATEGY RESEARCH & EVALUATION BENCHMARK (Fase 11) — compares the four
// baseline strategy families under IDENTICAL dataset/risk/evaluation
// conditions. Deliberately does NOT duplicate ReplayRun/ReplayResult: each
// strategy's underlying trade simulation is a completely normal ReplayRun,
// executed through the SAME `executeReplay()` every other replay uses.
// `replayRunId` below is a loose string reference (never a Prisma relation)
// to that row — mirroring `ReplayRun.strategyId`'s own established
// convention for pointing at something outside this table's own FK graph.
// ─────────────────────────────────────────────────────────────────────────

model StrategyBenchmarkRun {
  id                     String    @id @default(cuid())
  datasetSymbol          String // internal Asset.symbol, e.g. "BTC"
  timeframe              String
  startDate              DateTime
  endDate                DateTime
  evaluationProfileType  String // "20K" | "50K" | "100K" | "CUSTOM"
  evaluationConfig       String // JSON snapshot of the EXACT evaluation profile used — immutable even if the live EvaluationAccount template changes later
  riskLevel              Int
  // Fase 14 spec section 18 — reproducibility: which registered ResearchDataset (if any) every strategy in this run was simulated against. Loose reference, optional/nullable — undefined for every run predating Fase 14.
  datasetId              String?
  datasetHash            String?
  status                 String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  error                  String?
  createdAt              DateTime  @default(now())
  completedAt            DateTime?

  results StrategyBenchmarkResult[]
}

model StrategyBenchmarkResult {
  id                 String               @id @default(cuid())
  benchmarkRunId     String
  benchmarkRun       StrategyBenchmarkRun @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)
  strategyId         String // baseline StrategyDefinition id, e.g. "breakout-baseline-v1"
  strategyName       String
  strategyVersion    String
  strategyConfigHash String // spec section 20 — reproducibility
  replayRunId        String // the underlying ReplayRun this strategy actually simulated as
  metrics            String // JSON StrategyBenchmarkMetrics (performance/risk/evaluation/execution)
  evaluationStatus   String // PASS | FAIL | INCONCLUSIVE
  score              String // JSON BenchmarkScoreBreakdown
  createdAt          DateTime             @default(now())

  @@index([benchmarkRunId])
}

model Benchmark {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      String   @default("BUY_AND_HOLD")
  startDate DateTime
  endDate   DateTime
  metrics   String
  createdAt DateTime @default(now())

  @@index([assetId, startDate, endDate])
}

model Hypothesis {
  id                String           @id @default(cuid())
  statement         String
  strategyVersionId String?
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id])
  status            String           @default("PROPOSED") // PROPOSED, TESTING, ACCEPTED, REJECTED, INSUFFICIENT_EVIDENCE
  evidenceLevel     String? // LOW, MEDIUM, HIGH
  rationale         String?
  experimentId      String?          @unique
  experiment        Experiment?      @relation(fields: [experimentId], references: [id])
  createdAt         DateTime         @default(now())
  resolvedAt        DateTime?
}

model Experiment {
  id           String    @id @default(cuid())
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id])
  name         String
  durationDays Int
  config       String
  status       String    @default("PENDING")
  result       String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  hypothesis Hypothesis?
}

// ─────────────────────────────────────────────────────────────────────────
// PAPER TRADING
// ─────────────────────────────────────────────────────────────────────────

// Direction (plain String under SQLite): LONG | SHORT
//
// PositionStatus (plain String under SQLite): FLAT | PENDING | OPEN |
// PARTIALLY_CLOSED | CLOSED | ERROR

model PaperAccount {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String   @default("Main Paper Account")
  baseCurrency     String   @default("EUR")
  startingBalance  Float    @default(100)
  cashBalance      Float    @default(100)
  riskProfile      String   @default("BALANCED") // derived label — CONSERVATIVE, BALANCED, AGGRESSIVE, VERY_AGGRESSIVE, CUSTOM
  riskLevel        Int      @default(5) // 1-10, the real dial — see resolveRiskLimitsForLevel in riskEngine.ts
  isTradingBlocked Boolean  @default(false)
  blockedReason    String?
  createdAt        DateTime @default(now())

  orders    PaperOrder[]
  positions PaperPosition[]
  trades    Trade[]

  @@index([userId])
}

model PaperOrder {
  id                String           @id @default(cuid())
  accountId         String
  account           PaperAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset            @relation(fields: [assetId], references: [id])
  strategyVersionId String?
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id])
  direction         String
  requestedPrice    Float
  quantity          Float
  status            String           @default("PENDING") // PENDING, FILLED, REJECTED, CANCELLED
  gateResult        String // full trade-gate audit trail
  fillPrice         Float?
  slippage          Float?
  fee               Float?
  createdAt         DateTime         @default(now())
  filledAt          DateTime?

  position PaperPosition?

  @@index([accountId, status])
}

model PaperPosition {
  id                String           @id @default(cuid())
  accountId         String
  account           PaperAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset            @relation(fields: [assetId], references: [id])
  strategyVersionId String?
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id])
  openOrderId       String?          @unique
  openOrder         PaperOrder?      @relation(fields: [openOrderId], references: [id])
  direction         String
  status            String           @default("FLAT")
  entryPrice        Float
  quantity          Float
  remainingQuantity Float
  stopLoss          Float?
  takeProfit        Float?
  trailingStopPct   Float?
  openedAt          DateTime         @default(now())
  closedAt          DateTime?
  unrealizedPnl     Float            @default(0)
  realizedPnl       Float            @default(0)
  riskLevelAtEntry  Int? // account's 1-10 risk dial at the moment this was opened — for the Journal's risk-bucket breakdown; null on positions opened before this field existed
  snapshot          String // reproducibility snapshot: indicators, regime, news, sentiment, AI analysis at entry

  trades       Trade[]
  stateChanges PositionStateChange[]

  @@index([accountId, status])
}

model PositionStateChange {
  id         String        @id @default(cuid())
  positionId String
  position   PaperPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  reason     String
  source     String // "manual", "engine", "reconciliation"
  createdAt  DateTime      @default(now())

  @@index([positionId])
}

model Trade {
  id                String           @id @default(cuid())
  accountId         String
  account           PaperAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  positionId        String
  position          PaperPosition    @relation(fields: [positionId], references: [id])
  assetId           String
  asset             Asset            @relation(fields: [assetId], references: [id])
  strategyVersionId String?
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id])
  direction         String
  entryPrice        Float
  exitPrice         Float
  quantity          Float
  fees              Float            @default(0)
  slippageCost      Float            @default(0)
  grossPnl          Float
  netPnl            Float
  mae               Float // Max Adverse Excursion
  mfe               Float // Max Favorable Excursion
  durationSeconds   Int
  exitReason        String // STOP_LOSS, TAKE_PROFIT, SIGNAL, MANUAL, RISK, CIRCUIT_BREAKER
  marketRegime      String?
  riskLevelAtEntry  Int? // copied from PaperPosition.riskLevelAtEntry at close time
  journalId         String?          @unique
  journal           TradeJournal?
  openedAt          DateTime
  closedAt          DateTime

  @@index([accountId, closedAt])
  @@index([strategyVersionId])
}

model TradeJournal {
  id             String      @id @default(cuid())
  tradeId        String      @unique
  trade          Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  signalSnapshot String
  indicators     String
  news           String
  sentiment      String
  onChain        String
  aiAnalysis     String?
  aiCritic       String?
  riskScore      Float?
  postMortem     PostMortem?
  createdAt      DateTime    @default(now())
}

model PostMortem {
  id                String       @id @default(cuid())
  journalId         String       @unique
  journal           TradeJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  classification    String // GOOD_EXECUTION, BAD_EXECUTION, GOOD_IDEA_BAD_RESULT, BAD_IDEA_GOOD_RESULT, INSUFFICIENT_DATA, ANOMALY
  hypothesisCorrect Boolean?
  notes             String
  createdAt         DateTime     @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// RISK / SAFETY
// ─────────────────────────────────────────────────────────────────────────

// Fase 2 fix — was fully dead (no code ever wrote to it). Now populated by
// paperTradingEngine.ts whenever checkExposureLimits (riskEngine.ts) blocks
// a candidate, one row per RiskViolationKind it returned.
model RiskEvent {
  id        String   @id @default(cuid())
  accountId String?
  kind      String // EXPOSURE, POSITION_SIZE, CONCENTRATION, CORRELATION, DRAWDOWN, VOLATILITY — see RiskViolationKind in riskEngine.ts
  severity  String // INFO, WARN, CRITICAL
  message   String
  data      String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

model CircuitBreaker {
  id            String    @id @default(cuid())
  name          String    @unique
  kind          String // MAX_DAILY_LOSS, MAX_DRAWDOWN, MAX_TRADES, DATA_CORRUPTION, API_DOWN, POSITION_INCONSISTENCY, ANOMALY
  threshold     String
  isTripped     Boolean   @default(false)
  trippedAt     DateTime?
  trippedReason String?
  resetAt       DateTime?
  updatedAt     DateTime  @updatedAt
}

model SystemAlert {
  id           String   @id @default(cuid())
  kind         String
  severity     String // INFO, WARN, CRITICAL
  title        String
  message      String
  data         String?
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────────────────────────────────

model AIAnalysis {
  id                String   @id @default(cuid())
  kind              String // ANALYST, CRITIC
  assetId           String?
  strategyVersionId String?
  input             String
  output            String
  model             String
  tokensIn          Int      @default(0)
  tokensOut         Int      @default(0)
  estimatedCost     Float    @default(0)
  cached            Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([kind, createdAt])
}

model AIUsage {
  id            String   @id @default(cuid())
  day           DateTime // truncated to day, UTC
  callsCount    Int      @default(0)
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  estimatedCost Float    @default(0)
  cacheHits     Int      @default(0)
  cacheMisses   Int      @default(0)

  @@unique([day])
}

// ─────────────────────────────────────────────────────────────────────────
// AUTONOMOUS BOT LOOP
// ─────────────────────────────────────────────────────────────────────────

// Singleton row (id always "main") — the on/off switch and last-run bookkeeping
// for the continuous paper-trading loop (see src/lib/botLoop.ts). Bot status
// (plain String): ACTIVE | PAUSED | ANALYZING | WAITING | BLOCKED | ERROR | DEGRADED
model BotConfig {
  id                String    @id @default("main")
  accountId         String    @default("main-paper-account")
  isActive          Boolean   @default(true)
  status            String    @default("WAITING")
  statusDetail      String?
  intervalSeconds   Int       @default(60)
  lastRunAt         DateTime?
  lastRunDurationMs Int?
  nextRunAt         DateTime?
  updatedAt         DateTime  @updatedAt
}

// Fase 6 — "Daily Profit Protection" (see engines/dailyProfitProtection.ts).
// A state machine (NORMAL / PROFIT_PROTECTION / HARD_DAILY_STOP) driven by
// real realized+unrealized daily P&L against the account's own starting
// equity for the day — never an AI opinion. Persistent/editable from
// Settings, single source of truth for every scan (mirrors BotConfig).
model ProfitProtectionConfig {
  id                          String    @id @default("main")
  accountId                   String    @default("main-paper-account")
  isEnabled                   Boolean   @default(true)
  // Daily P&L% (realized+unrealized vs start-of-day equity) at or above
  // this enters PROFIT_PROTECTION: new trades need the "exceptional
  // opportunity" exception below; open positions are still managed normally.
  profitProtectionTriggerPct  Float     @default(3)
  // Daily P&L% at or below this enters HARD_DAILY_STOP: NO new trades at
  // all, no exception — only open-position management continues.
  hardStopLossPct             Float     @default(-5)
  // The "exceptional opportunity" exception while in PROFIT_PROTECTION must
  // be quantitative and verifiable — never "the AI says it's good" alone.
  // ALL of these must hold (see checkExceptionalOpportunity):
  exceptionalMinConfidence    Float     @default(0.85) // AI Analyst confidence floor
  exceptionalMinEvidenceLevel String    @default("MEDIUM") // luckVsEdge evidenceLevel: LOW < MEDIUM < HIGH — real trade history required, not a fresh strategy
  exceptionalSizeMultiplier   Float     @default(0.5) // even an exceptional trade sizes down while protecting the day's gains
  // Last state seen (NORMAL/PROFIT_PROTECTION/HARD_DAILY_STOP), so
  // paperTradingEngine.ts only raises a SystemAlert on a STATE TRANSITION,
  // not on every single scan cycle spent in the same state.
  lastState                   String    @default("NORMAL")
  lastStateAt                 DateTime?
  updatedAt                   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// MT5 DEMO EXECUTION (Fase 1 — demo-only foundation)
// ─────────────────────────────────────────────────────────────────────────
//
// EdgeLab AI's MetaTrader 5 integration is restricted to DEMO accounts in
// this version — see docs/mt5-demo-integration.md. Nothing here can ever
// hold a password: MT5 credentials (login/password/server) are supplied at
// connect-time as an in-memory parameter only and are never written to any
// Prisma model, logged, or echoed back in an API response. `loginId` is the
// MT5 account NUMBER (an identifier, not a secret) — kept so the app can
// show which account is connected and reconnect to the same one, but it is
// still masked in every API response and UI surface (see mt5AccountInfo.ts).

// Singleton row (id always "main") — mirrors BotConfig/ProfitProtectionConfig's
// pattern. `executionEnabled` is the global Safety Switch (section 16 of the
// spec): defaults to false and is the ONLY field that gates
// MT5DemoExecutionAdapter.placeOrder — see demoAccountGuard.ts. It can only
// ever be flipped true by canEnableMt5Execution() after verifiedDemo is true
// for THIS session's connection; a lost connection or a fresh process start
// resets it back to false (never persisted as "was enabled last time").
model MT5DemoConnection {
  id               String    @id @default("main")
  accountId        String    @default("main-paper-account")
  status           String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  statusDetail     String?
  broker           String?
  server           String?
  loginId          String? // MT5 account number — NOT a secret, but still masked in every API/UI surface
  accountType      String? // "DEMO" | "LIVE" | null — set ONLY from what MT5 itself reports via verifyAccountIsDemo(), never assumed or guessed
  verifiedDemo     Boolean   @default(false) // true only once verifyAccountIsDemo() has explicitly confirmed accountType === "DEMO" for the CURRENT connection
  balance          Float?
  equity           Float?
  margin           Float?
  freeMargin       Float?
  leverage         Int?
  currency         String?
  latencyMs        Int?
  lastSyncAt       DateTime?
  lastErrorMessage String? // sanitized by construction — every write path here is credential-redacted, see mt5DemoExecutionAdapter.ts
  executionEnabled Boolean   @default(false) // the Safety Switch — OFF by default; see canEnableMt5Execution()
  updatedAt        DateTime  @updatedAt
}

// Fase 1 execution audit trail (spec section 15). Deliberately has NO field
// that could ever hold a credential — there is nothing here to redact
// because nothing secret is ever passed into this model's data in the
// first place (see executionEventLog.ts).
model ExecutionEvent {
  id                 String   @id @default(cuid())
  // strategyId:symbol:signalTimestamp:direction (see duplicateOrderGuard.ts)
  // — unique so a retry/reconnection/timeout/UI-refresh/bot-restart can
  // never place a second order for the same signal, even across process
  // restarts (an in-memory-only lock would not survive one).
  idempotencyKey     String?  @unique
  // Fase MT5.2 — which one of the 15 pre-flight checks rejected this
  // signal, e.g. "MT5_CONNECTED" | "RISK_ENGINE" | "SL_TP_RRR" — see
  // executionChecklist.ts. Null when status is not REJECTED.
  failedCheck        String?
  // The signal's own identity string (see duplicateOrderGuard.ts's
  // SignalIdentity) — kept even when idempotencyKey collides with an
  // existing row (a rejected duplicate never gets its own row; this field
  // still lets a REJECTED row for a distinct signal be traced back to it).
  signalId           String?
  symbol             String
  side               String // BUY | SELL
  requestedVolume    Float?
  approvedVolume     Float?
  entryPrice         Float?
  stopLoss           Float?
  takeProfit         Float?
  riskAmount         Float?
  rrr                Float?
  mt5Ticket          String?
  status             String // REQUESTED | APPROVED | REJECTED | SUBMITTED | FILLED | FAILED_EXECUTION | ERROR | SYNCHRONIZED
  executionLatencyMs Int?
  rejectionReason    String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// MT5 EVALUATION / SYMBOL MAPPING / POSITION SYNC (Fase 2)
// ─────────────────────────────────────────────────────────────────────────

// Singleton row (id "main") — a prop-firm-style evaluation account layered
// ON TOP of the MT5 demo connection. Deliberately separate from
// `MT5DemoConnection` (spec section 10): MT5 sync only ever feeds live
// readings (currentEquity) INTO the functions in evaluationRiskEngine.ts —
// it never overwrites this row's own configured rules (targets/limits).
// `profileType` records which template (20K/50K/100K) seeded this row, or
// "CUSTOM"; the actual thresholds below are always the live, editable
// source of truth regardless of which template created them.
model EvaluationAccount {
  id                  String    @id @default("main")
  accountId           String    @default("main-paper-account")
  profileType         String    @default("CUSTOM") // "20K" | "50K" | "100K" | "CUSTOM"
  initialBalance      Float
  phase               String    @default("PHASE_1") // PHASE_1 | PHASE_2
  phase1TargetPct     Float     @default(10)
  phase2TargetPct     Float     @default(5)
  dailySafetyPct      Float     @default(-3) // negative — daily P&L% at/below this blocks new entries
  dailyHardPct        Float     @default(-5) // negative — daily P&L% at/below this FAILS the evaluation
  totalSafetyPct      Float     @default(-6) // negative — total P&L% at/below this halves currentRiskPct
  totalHardPct        Float     @default(-10) // negative — total P&L% at/below this FAILS the evaluation
  baseRiskPct         Float     @default(1)
  minRRR              Float     @default(1.5)
  // Portfolio-shape limits for THIS evaluation account specifically —
  // deliberately separate from the paper account's Risk Level 1-10 dial
  // (riskEngine.ts), since the evaluation is its own account with its own
  // rules. Defaults mirror the existing BALANCED preset.
  maxOpenPositions    Int       @default(4)
  maxExposurePct      Float     @default(50)
  maxConcentrationPct Float     @default(25)
  status              String    @default("ACTIVE") // ACTIVE | TARGET_REACHED | FAILED — sticky once terminal, see evaluationRiskEngine.ts
  // Day-boundary bookkeeping (spec section 11) — always computed in UTC
  // shifted by `resetHourUtc`, NEVER server-local time, so a day never
  // resets at the wrong moment depending on where this process happens to
  // run. dayStartDate is the shifted-UTC "YYYY-MM-DD" key of the CURRENT
  // trading day; dayStartEquity is the equity reading captured the first
  // time that key was seen.
  resetHourUtc        Int       @default(0)
  dayStartDate        String?
  dayStartEquity      Float?
  startedAt           DateTime  @default(now())
  targetReachedAt     DateTime?
  daysToTarget        Int?
  finalEquity         Float?
  finalBalance        Float?
  failureReason       String?
  failedAt            DateTime?
  updatedAt           DateTime  @updatedAt
}

// Explicit EdgeLab symbol <-> MT5 broker symbol mapping (spec section 5) —
// never inferred. One row per EdgeLab symbol; `mt5Symbol` is whatever the
// connected broker actually calls it (e.g. "BTCUSDm"). `enabled: false`
// lets a mapping be turned off without deleting the audit trail of what it
// used to point to.
model Mt5SymbolMapping {
  id            String   @id @default(cuid())
  edgeLabSymbol String   @unique
  mt5Symbol     String
  enabled       Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// Fase 2 — MT5PositionSynchronizer's own persisted view. MT5 itself is
// always the source of truth (spec section 6/14): this table is a CACHE of
// the adapter's last successful `getOpenPositions()` read, refreshed every
// sync, never written to speculatively from an order response alone (see
// mt5PositionSynchronizer.ts) — "EdgeLab nunca debe asumir que una orden
// se ejecutó correctamente."
model Mt5DemoPosition {
  id            String   @id @default(cuid())
  ticket        String   @unique
  symbol        String
  side          String
  volume        Float
  entryPrice    Float
  currentPrice  Float
  stopLoss      Float?
  takeProfit    Float?
  unrealizedPnl Float
  openTime      DateTime
  lastSyncedAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// SYSTEM HEALTH / AUDIT
// ─────────────────────────────────────────────────────────────────────────

model SystemHealth {
  id          String   @id @default(cuid())
  score       Int // 0-100
  components  String // { dataQuality, apiHealth, positionConsistency, anomalyCount }
  evaluatedAt DateTime @default(now())

  @@index([evaluatedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  data      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
