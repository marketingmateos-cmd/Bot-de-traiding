# Copy to .env(.local) and fill in as needed.
# The app runs fully in DEMO MODE with no external keys at all.

# --- Database (required) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_ai_trading_lab"

# --- Environment ---
NODE_ENV="development"
APP_ENV="dev" # dev | test | production

# --- Market data / news / sentiment / on-chain providers ---
# Leave unset to force DEMO providers (clearly labeled synthetic data).
MARKET_DATA_PROVIDER="demo" # demo | coingecko
NEWS_PROVIDER="demo"
SENTIMENT_PROVIDER="demo"
ONCHAIN_PROVIDER="demo"

# --- AI (Analyst / Critic layers) ---
# Leave ANTHROPIC_API_KEY unset to run the AI layer in DEMO mode
# (rule-based structured output, clearly labeled, no external calls).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_DAILY_CALL_BUDGET="200"
AI_MONTHLY_COST_BUDGET_USD="20"

# --- Risk defaults ---
DEFAULT_RISK_PROFILE="BALANCED"

# --- MT5 DEMO data connector (read-only historical data ingestion) ---
# Leave all three unset to run with no MT5 connectivity at all — nothing in
# EdgeLab AI requires MT5 to function. Only a MetaTrader 5 DEMO account is
# ever accepted; a LIVE account is rejected outright by an inviolable check
# against the official ACCOUNT_TRADE_MODE attribute (never a name/comment/
# env-var proxy). Never commit real values — this file only documents the
# variable names.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Execution kill switch for the MT5 connection — independent of, and in
# addition to, the DB-backed Safety Switch (MT5DemoConnection.executionEnabled).
# MUST stay "false" for the MT5 Data Connector phase: this phase is
# read-only historical data ingestion only, never order execution, not even
# on a demo account. Only "true" (case-insensitive) enables it; anything
# else — unset, empty, any other value — is treated as false.
ENABLE_DEMO_EXECUTION=false
