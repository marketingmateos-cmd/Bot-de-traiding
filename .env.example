# Copy to .env(.local) and fill in as needed.
# The app runs fully in DEMO MODE with no external keys at all.

# --- Database (required) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_ai_trading_lab"

# --- Environment ---
NODE_ENV="development"
APP_ENV="dev" # dev | test | production

# --- Market data / news / sentiment / on-chain providers ---
# Leave unset to force DEMO providers (clearly labeled synthetic data).
MARKET_DATA_PROVIDER="demo" # demo | coingecko
NEWS_PROVIDER="demo"
SENTIMENT_PROVIDER="demo"
ONCHAIN_PROVIDER="demo"

# --- AI (Analyst / Critic layers) ---
# Leave ANTHROPIC_API_KEY unset to run the AI layer in DEMO mode
# (rule-based structured output, clearly labeled, no external calls).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_DAILY_CALL_BUDGET="200"
AI_MONTHLY_COST_BUDGET_USD="20"

# --- Risk defaults ---
DEFAULT_RISK_PROFILE="BALANCED"
